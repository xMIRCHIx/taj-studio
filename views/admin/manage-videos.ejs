<%- include('../partials/head') %>

<!-- Admin Nav -->
<header class="admin-navbar">
  <a href="/admin/dashboard" class="admin-logo" style="text-decoration: none; color: inherit;">TAJ STUDIO <span>ADMIN</span></a>
  <a href="/admin/dashboard" class="admin-logout-btn" style="text-decoration: none;">&larr; Dashboard</a>
</header>

<!-- Main Container -->
<main class="admin-main">
  <div class="admin-header-row">
    <div>
      <h1 class="admin-title">Manage Cinematic Films</h1>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Drag rows to reorder. Changes save automatically and reflect live on the website.</p>
    </div>
    <a href="/admin/upload-video" class="btn btn-gold" style="padding: 0.75rem 1.5rem; font-size: 0.75rem; border-radius: 6px;">+ Upload Video</a>
  </div>

  <!-- Flash Messages -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success">
      <span><%= success %></span>
      <button class="alert-close">&times;</button>
    </div>
  <% } %>
  
  <% if (error && error.length > 0) { %>
    <div class="alert alert-error">
      <span><%= error %></span>
      <button class="alert-close">&times;</button>
    </div>
  <% } %>

  <!-- Reorder status -->
  <% if (videos.length > 0) { %>
  <div id="reorderStatusVid" style="display:none; padding: 0.6rem 1rem; border-radius: 6px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; background: #d4edda; color: #155724;">
    ✅ Order saved successfully!
  </div>
  <% } %>

  <!-- Video Management -->
  <div class="admin-card" style="margin-top: 1rem;">
    <% if (videos.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1.5rem;">
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 0.5rem;">No films uploaded yet</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Publish your first film to start showcasing your portfolio.</p>
        <a href="/admin/upload-video" class="btn btn-gold" style="border-radius: 6px;">Upload a Film</a>
      </div>
    <% } else { %>

      <!-- Desktop Table View -->
      <div class="table-wrapper desktop-only-table">
        <table class="admin-table">
          <thead>
            <tr>
              <th style="width: 30px;"></th>
              <th style="width: 100px;">Cover</th>
              <th>Film Title</th>
              <th>Category</th>
              <th>Source</th>
              <th>Published Date</th>
              <th style="width: 80px; text-align: center;">Actions</th>
            </tr>
          </thead>
          <tbody id="videoDragTable">
            <% videos.forEach(video => { %>
              <tr class="draggable-row" draggable="true" data-id="<%= video.id %>" style="cursor: grab;">
                <td style="color:#ccc; font-size:1.2rem; cursor:grab; user-select:none;">⠿</td>
                <td>
                  <div class="admin-table-thumb">
                    <img src="<%= video.thumbnail %>" alt="Thumbnail" onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=150&q=80'">
                  </div>
                </td>
                <td style="font-weight: 500;"><%= video.title %></td>
                <td><span class="admin-tag"><%= video.category %></span></td>
                <td>
                  <span class="admin-tag <%= video.video_type === 'youtube' ? 'admin-tag-youtube' : 'admin-tag-upload' %>">
                    <%= video.video_type %>
                  </span>
                </td>
                <td><%= new Date(video.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                <td style="text-align: center;">
                  <form action="/admin/video/<%= video.id %>?_method=DELETE" method="POST" class="admin-delete-form">
                    <button type="submit" class="btn-delete" title="Delete Film">
                      <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Card View -->
      <div class="mobile-cards-list" id="videoDragMobile">
        <% videos.forEach(video => { %>
          <div class="mobile-item-card draggable-row" draggable="true" data-id="<%= video.id %>" style="cursor: grab;">
            <div class="mobile-item-thumb">
              <img src="<%= video.thumbnail %>" alt="<%= video.title %>" onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=300&q=80'">
            </div>
            <div class="mobile-item-info">
              <h4><%= video.title %></h4>
              <div class="mobile-item-tags">
                <span class="admin-tag"><%= video.category %></span>
                <span class="admin-tag <%= video.video_type === 'youtube' ? 'admin-tag-youtube' : 'admin-tag-upload' %>"><%= video.video_type %></span>
              </div>
              <p class="mobile-item-date"><%= new Date(video.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
            </div>
            <form action="/admin/video/<%= video.id %>?_method=DELETE" method="POST" class="admin-delete-form mobile-item-delete">
              <button type="submit" class="btn-delete" title="Delete Film">
                <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
              </button>
            </form>
          </div>
        <% }) %>
      </div>

    <% } %>
  </div>
</main>

<%- include('../partials/admin-mobile-nav') %>
<script src="/js/main.js"></script>

<style>
.draggable-row { transition: opacity 0.2s; }
.draggable-row.dragging { opacity: 0.4; }
.draggable-row.drag-over-row { outline: 2px dashed var(--gold); }
</style>

<script>
(function() {
  // Shared save function
  function saveVideoOrder(container, selector) {
    const rows = [...container.querySelectorAll(selector)];
    const order = rows.map((r, i) => ({ id: parseInt(r.dataset.id), order_index: i }));
    fetch('/admin/reorder-videos', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const s = document.getElementById('reorderStatusVid');
        s.style.display = 'block';
        setTimeout(() => { s.style.display = 'none'; }, 2500);
      }
    })
    .catch(console.error);
  }

  function makeDraggable(container, rowSelector, saveContainer, saveSel) {
    if (!container) return;
    let dragged = null;
    container.addEventListener('dragstart', e => {
      dragged = e.target.closest(rowSelector);
      if (dragged) dragged.classList.add('dragging');
    });
    container.addEventListener('dragend', e => {
      const el = e.target.closest(rowSelector);
      if (el) el.classList.remove('dragging');
      container.querySelectorAll('.drag-over-row').forEach(el => el.classList.remove('drag-over-row'));
      saveVideoOrder(saveContainer || container, saveSel || rowSelector);
    });
    container.addEventListener('dragover', e => {
      e.preventDefault();
      const target = e.target.closest(rowSelector);
      if (target && target !== dragged) {
        container.querySelectorAll('.drag-over-row').forEach(el => el.classList.remove('drag-over-row'));
        target.classList.add('drag-over-row');
      }
    });
    container.addEventListener('drop', e => {
      e.preventDefault();
      const target = e.target.closest(rowSelector);
      if (target && dragged && target !== dragged) {
        const all = [...container.querySelectorAll(rowSelector)];
        if (all.indexOf(dragged) < all.indexOf(target)) {
          container.insertBefore(dragged, target.nextSibling);
        } else {
          container.insertBefore(dragged, target);
        }
      }
    });
  }

  makeDraggable(document.getElementById('videoDragTable'), '.draggable-row');
  makeDraggable(document.getElementById('videoDragMobile'), '.draggable-row');
})();
</script>

</body>
</html>
