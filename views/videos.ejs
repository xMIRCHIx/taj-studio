<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Video Landing Hero -->
<header class="landing-hero" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1920&q=80');">
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    <span class="eyebrow" style="color: var(--gold); margin-bottom: 1rem;">Cinematic Films</span>
    <h1 class="display-headline" style="font-size: clamp(2.5rem, 6vw, 4.5rem); margin-bottom: 0;">Our Film Portfolio</h1>
  </div>
</header>

