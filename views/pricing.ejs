<!-- Floating Estimate Summary Bar -->
<div class="floating-estimate-bar" id="estimateBar">
  <div class="estimate-summary">
    <span class="estimate-count" id="estimateCount">Selected: 0 Services</span>
    <span class="estimate-total-price" id="estimateTotal">Est: ₹0</span>
  </div>
  <a href="#" class="estimate-book-btn" id="estimateBookBtn">Proceed to Book</a>
</div>

<!-- Tab & Selection Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching Logic
    const tabBtns = document.querySelectorAll('.pricing-tab-btn');
    const panels = document.querySelectorAll('.pricing-tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        const targetTab = btn.getAttribute('data-tab');
        const targetPanel = document.getElementById(`panel-${targetTab}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    // 2. Estimate Builder Logic
    const selectBtns = document.querySelectorAll('.pricing-select-btn');
    const listCheckboxes = document.querySelectorAll('.pricing-list-checkbox');
    const estimateBar = document.getElementById('estimateBar');
    const estimateCountEl = document.getElementById('estimateCount');
    const estimateTotalEl = document.getElementById('estimateTotal');
    const estimateBookBtn = document.getElementById('estimateBookBtn');

    // Selected state tracker
    let selectedServices = {};

    // Toggle card selection
    selectBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.pricing-card') || btn.closest('.pricing-tier-card');
        const name = btn.getAttribute('data-name');
        const price = parseInt(btn.getAttribute('data-price'));

        if (card.classList.contains('selected')) {
          // Deselect
          card.classList.remove('selected');
          btn.textContent = 'Select Package';
          delete selectedServices[name];
        } else {
          // Select (if it's in a single category grid like basic/premium/luxury album, let's allow multi or toggle. Let's toggle only for that category to avoid picking basic+premium together, OR keep it pure additive. Additive is better as users can check details. Let's keep it additive but update visual cues).
          card.classList.add('selected');
          btn.textContent = 'Selected ✓';
          selectedServices[name] = price;
        }
        updateEstimate();
      });
    });

    // Toggle list checkbox selection
    listCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        const listItem = cb.closest('.pricing-list-item');
        const name = cb.getAttribute('data-name');
        const price = parseInt(cb.getAttribute('data-price'));

        if (cb.checked) {
          listItem.classList.add('selected');
          selectedServices[name] = price;
        } else {
          listItem.classList.remove('selected');
          delete selectedServices[name];
        }
        updateEstimate();
      });
    });

    // Calculate totals & update estimate drawer
    function updateEstimate() {
      const names = Object.keys(selectedServices);
      const total = Object.values(selectedServices).reduce((sum, val) => sum + val, 0);
      const count = names.length;

      if (count > 0) {
        estimateCountEl.textContent = `Selected: ${count} Service${count > 1 ? 's' : ''}`;
        estimateTotalEl.textContent = `Est: ₹${total.toLocaleString('en-IN')}`;
        
        // Build booking query URL
        const serviceQuery = encodeURIComponent(names.join(', '));
        estimateBookBtn.href = `/contact?services=${serviceQuery}&estimate=${total}`;
        
        // Show bar
        estimateBar.classList.add('visible');
      } else {
        // Hide bar
        estimateBar.classList.remove('visible');
      }
    }

    // 3. Reveal animations on scroll
    const reveals = document.querySelectorAll('.reveal');
    const handleScroll = () => {
      const windowHeight = window.innerHeight;
      reveals.forEach(el => {
        const elementTop = el.getBoundingClientRect().top;
        if (elementTop < windowHeight - 50) {
          el.classList.add('visible');
        }
      });
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();
  });
</script>

