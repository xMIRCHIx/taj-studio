<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Contact Hero -->
<header class="landing-hero" style="background-image: url('https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=1920&q=80'); height: 40vh;">
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    <span class="eyebrow" style="color: var(--gold); margin-bottom: 1rem;">Let's Connect</span>
    <h1 class="display-headline" style="font-size: clamp(2.5rem, 6vw, 4.5rem); margin-bottom: 0;">Book a Session</h1>
  </div>
</header>

<!-- Contact Form Section -->
<section class="contact-section">
  <div class="container">
    
    <!-- Flash Messages -->
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success">
        <span><%= success %></span>
        <button class="alert-close">&times;</button>
      </div>
    <% } %>
    
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error">
        <span><%= error %></span>
        <button class="alert-close">&times;</button>
      </div>
    <% } %>

    <div class="contact-grid reveal">
      <!-- Left Column: Details & Socials -->
      <div class="contact-info-panel">
        <div>
          <h2>Get in Touch</h2>
          <div class="contact-details">
            <div class="contact-detail-item">
              <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <h4>Our Studio HQ</h4>
                <p><%= settings.contact_address %></p>
              </div>
            </div>
            <div class="contact-detail-item">
              <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <h4>Phone Call</h4>
                <p><%= settings.contact_phone %></p>
              </div>
            </div>
            <div class="contact-detail-item">
              <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <div>
                <h4>General Queries</h4>
                <p><%= settings.contact_email %></p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h4 style="color: var(--white); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;">Follow Us</h4>
          <div class="contact-socials">
            <% if (settings.contact_instagram) { %>
              <a href="<%= settings.contact_instagram %>" class="social-circle" aria-label="Instagram" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
            <% } %>
            <% if (settings.contact_facebook) { %>
              <a href="<%= settings.contact_facebook %>" class="social-circle" aria-label="Facebook" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
            <% } %>
            <% if (settings.contact_youtube) { %>
              <a href="<%= settings.contact_youtube %>" class="social-circle" aria-label="YouTube" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon></svg></a>
            <% } %>
            <% if (settings.contact_whatsapp) { %>
              <a href="<%= settings.contact_whatsapp %>" class="social-circle" aria-label="WhatsApp" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></a>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="contact-form-panel">
        <form action="/contact" method="POST" id="contactForm">
          <div class="form-group">
            <label for="name">Your Name *</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="E.g., Aditya Sharma" required>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="aditya@example.com" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" class="form-control" placeholder="+91 XXXXX XXXXX" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="event_type">Event Category</label>
              <select id="event_type" name="event_type" class="form-control">
                <option value="wedding">Wedding Film & Shoot</option>
                <option value="prewedding">Pre-Wedding Story</option>
                <option value="anniversary">Anniversary Shoots</option>
                <option value="engagement">Engagement Celebration</option>
                <option value="birthday">Birthday & Social Event</option>
                <option value="indoor">Studio Indoor Session</option>
              </select>
            </div>
            <div class="form-group">
              <label for="event_date">Event Date (Approximate)</label>
              <input type="date" id="event_date" name="event_date" class="form-control">
            </div>
          </div>

          <div class="form-group">
            <label for="message">Tell Us About Your Vision</label>
            <textarea id="message" name="message" class="form-control" placeholder="Describe details of your event (locations, culture themes, special requirements)"></textarea>
          </div>

          <button type="submit" class="btn btn-gold" style="width: 100%; border-radius: 8px; margin-top: 1rem;">Send Booking Request</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
