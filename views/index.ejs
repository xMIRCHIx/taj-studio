<!-- Section 5: Featured Work -->
<section class="featured-work reveal">
  <div class="container">
    <div class="featured-header">
      <div>
        <span class="eyebrow">Portfolio Highlights</span>
        <h2 class="section-headline">Featured Works</h2>
      </div>
      <div class="carousel-nav-btns">
        <button class="carousel-nav-btn carousel-prev" aria-label="Previous Slide">&#10229;</button>
        <button class="carousel-nav-btn carousel-next" aria-label="Next Slide">&#10230;</button>
      </div>
    </div>

    <div class="carousel-viewport">
      <div class="carousel-container">
        <% if (featuredVideos.length === 0 && featuredPhotos.length === 0) { %>
          <!-- 6 Placeholders when database is empty -->
          <div class="carousel-slide video-card-trigger" data-youtube-url="https://www.youtube.com/watch?v=dQw4w9WgXcQ" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80" alt="Wedding Film Placeholder">
            <div class="play-badge" style="opacity: 1; transform: translate(-50%, -50%) scale(1); background: rgba(255,255,255,0.9);"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <div class="slide-overlay">
              <span class="category-tag">Wedding Films</span>
              <h3>Ananya & Kabir</h3>
              <p>Royal Udaipur Heritage Wedding (Play Sample)</p>
            </div>
          </div>
          <div class="carousel-slide video-card-trigger" data-youtube-url="https://www.youtube.com/watch?v=dQw4w9WgXcQ" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=600&q=80" alt="Prewedding Film Placeholder">
            <div class="play-badge" style="opacity: 1; transform: translate(-50%, -50%) scale(1); background: rgba(255,255,255,0.9);"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <div class="slide-overlay">
              <span class="category-tag">Pre-Wedding</span>
              <h3>Rohan & Meera</h3>
              <p>Sunrise at the Taj Mahal (Play Sample)</p>
            </div>
          </div>
          <div class="carousel-slide photo-item-trigger" data-src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80" data-title="Aditya & Riya — Sunset Vows in Goa" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80" alt="Wedding Photo Placeholder">
            <div class="slide-overlay">
              <span class="category-tag">Wedding Portfolio</span>
              <h3>Aditya & Riya</h3>
              <p>Sunset Vows in Goa (View Image)</p>
            </div>
          </div>
          <div class="carousel-slide photo-item-trigger" data-src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=1200&q=80" data-title="Dev & Sonia — Jaipur Palace Session" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=600&q=80" alt="Engagement Portrait Placeholder">
            <div class="slide-overlay">
              <span class="category-tag">Engagement Portfolio</span>
              <h3>Dev & Sonia</h3>
              <p>Jaipur Palace Royal Session (View Image)</p>
            </div>
          </div>
          <div class="carousel-slide photo-item-trigger" data-src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1200&q=80" data-title="Aarav's Milestone Celebration" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=600&q=80" alt="Birthday Showcase Placeholder">
            <div class="slide-overlay">
              <span class="category-tag">Birthday Portfolio</span>
              <h3>Aarav's Milestone</h3>
              <p>Vibrant 1st Birthday Celebration (View Image)</p>
            </div>
          </div>
          <div class="carousel-slide photo-item-trigger" data-src="https://images.unsplash.com/photo-1520854221256-174b1ec358ef?auto=format&fit=crop&w=1200&q=80" data-title="Shanaya Kapoor — High-Fashion Editorial" style="cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1520854221256-174b1ec358ef?auto=format&fit=crop&w=600&q=80" alt="Indoor Studio Placeholder">
            <div class="slide-overlay">
              <span class="category-tag">Indoor Studio</span>
              <h3>Shanaya Kapoor</h3>
              <p>High-Fashion Editorial Session (View Image)</p>
            </div>
          </div>
        <% } else { %>
          <% 
            // Mix videos and photos together
            const combinedItems = featuredVideos.map(v => ({...v, isVideo: true})).concat(featuredPhotos.map(p => ({...p, isVideo: false})));
            combinedItems.forEach(item => { 
          %>
            <div class="carousel-slide <%= item.isVideo ? 'video-card-trigger' : 'photo-item-trigger' %>" 
                 <%= item.isVideo ? `data-youtube-url="${item.youtube_url}" data-video-url="${item.file_path}"` : `data-src="${item.file_path}" data-title="${item.title || 'Taj Studio Photo'}"` %> 
                 style="cursor: pointer;">
              <img src="<%= item.thumbnail || item.file_path %>" alt="<%= item.title || 'Taj Studio Feature' %>" onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80'">
              <% if (item.isVideo) { %>
                <div class="play-badge" style="opacity: 1; transform: translate(-50%, -50%) scale(1); background: rgba(255,255,255,0.9);"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
              <% } %>
              <div class="slide-overlay">
                <span class="category-tag"><%= item.category %> <%= item.isVideo ? 'Films' : 'Photography' %></span>
                <h3><%= item.title || 'Taj Studio Capture' %></h3>
                <p><%= item.isVideo ? 'Play Film' : 'View Image' %></p>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Section 5.5: UGC Social Reels -->
<section class="ugc-section reveal">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem;">
      <div>
        <span class="eyebrow">Behind The Lens</span>
        <h2 class="section-headline">Taj Reels & Behind-The-Scenes</h2>
      </div>
      <div class="carousel-nav-btns" style="position: static; transform: none; margin-bottom: 0.5rem;">
        <button class="carousel-nav-btn ugc-prev" aria-label="Previous Reels">&#10229;</button>
        <button class="carousel-nav-btn ugc-next" aria-label="Next Reels">&#10230;</button>
      </div>
    </div>
  </div>

  <div class="ugc-carousel-viewport" data-autoplay-speed="<%= settings.ugc_duration %>">
    <div class="ugc-carousel-container">
      <% if (ugcItems.length === 0) { %>
        <!-- Default UGC Items -->
        <div class="ugc-slide">
          <div class="ugc-card photo-item-trigger" data-src="https://images.unsplash.com/photo-1520854221256-174b1ec358ef?auto=format&fit=crop&w=600&h=800&q=80" data-title="Candid Groom Portraits">
            <img src="https://images.unsplash.com/photo-1520854221256-174b1ec358ef?auto=format&fit=crop&w=600&h=800&q=80" alt="Insta Vibe 1">
            <div class="ugc-card-overlay">
              <span class="ugc-tag">Insta Moments</span>
              <h4>Behind The Lens</h4>
            </div>
          </div>
        </div>
        <div class="ugc-slide">
          <div class="ugc-card photo-item-trigger" data-src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&h=800&q=80" data-title="Cinematic Bride Portraits">
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&h=800&q=80" alt="Insta Vibe 2">
            <div class="ugc-card-overlay">
              <span class="ugc-tag">Couple Vibe</span>
              <h4>Real Happiness</h4>
            </div>
          </div>
        </div>
        <div class="ugc-slide">
          <div class="ugc-card photo-item-trigger" data-src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=600&h=800&q=80" data-title="Royal Heritage Setup">
            <img src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=600&h=800&q=80" alt="Insta Vibe 3">
            <div class="ugc-card-overlay">
              <span class="ugc-tag">Slow Motion</span>
              <h4>Royal Groom Walk</h4>
            </div>
          </div>
        </div>
        <div class="ugc-slide">
          <div class="ugc-card photo-item-trigger" data-src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&h=800&q=80" data-title="The Grand Entry">
            <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&h=800&q=80" alt="Insta Vibe 4">
            <div class="ugc-card-overlay">
              <span class="ugc-tag">Candid</span>
              <h4>The First Look</h4>
            </div>
          </div>
        </div>
      <% } else { %>
        <% ugcItems.forEach(item => { %>
          <div class="ugc-slide">
            <% if (item.type === 'video') { %>
              <div class="ugc-card video-card-trigger" data-video-url="<%= item.file_path %>" style="cursor: pointer;">
                <video src="<%= item.file_path %>" muted loop playsinline class="ugc-video-preview"></video>
                <div class="ugc-play-icon">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3l14 9-14 9V3z" fill="currentColor"/></svg>
                </div>
                <div class="ugc-card-overlay">
                  <span class="ugc-tag">Video Reel</span>
                  <h4>Cinematic Short</h4>
                </div>
              </div>
            <% } else { %>
              <div class="ugc-card photo-item-trigger" data-src="<%= item.file_path %>" data-title="Social Stories" style="cursor: pointer;">
                <img src="<%= item.file_path %>" alt="Social Media Vibe">
                <div class="ugc-card-overlay">
                  <span class="ugc-tag">Stills Story</span>
                  <h4>Candid Frame</h4>
                </div>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>

<!-- Section 6: Testimonials -->
