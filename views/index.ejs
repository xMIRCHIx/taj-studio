    <div class="slider-dots"></div>
  </div>
</section>

<!-- Section 7: CTA Banner -->
<section class="cta-banner reveal">
  <div class="container">
    <h2 class="section-headline" style="color: var(--white);">Let us capture your story</h2>
    <p>Are you ready to create a masterpiece that will stand the test of time? Let us design your custom package for your upcoming celebrations.</p>
    <a href="/contact" class="btn btn-gold">Secure Your Date Now</a>
  </div>
</section>

<!-- GSAP Animation Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap !== 'undefined') {
      gsap.from('.word', {
        opacity: 0, 
        y: 40, 
        duration: 0.8,
        stagger: 0.12, 
        ease: 'power3.out',
        delay: 0.3
      });
    }
  });
</script>

<%- include('partials/footer') %>
