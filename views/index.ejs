<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Section 1: Hero Slider -->
<header class="hero-slider-section" data-autoplay-duration="<%= settings.hero_duration %>">
  <div class="hero-slides-container">
    <% if (heroSlides.length === 0) { %>
      <div class="hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1920&q=80');">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
          <span class="eyebrow" style="color: var(--gold); margin-bottom: 1.5rem;">Luxury Wedding Film & Photography</span>
          <h1 class="display-headline">
            <span class="word">Crafting</span>
            <span class="word">Timeless</span>
            <span class="word">Moments</span>
          </h1>
          <p class="reveal">We capture your once-in-a-lifetime stories with cinematic elegance, creating emotional masterpieces that you will cherish forever.</p>
          <div class="hero-btns reveal">
            <a href="/contact" class="btn btn-gold">Book a Consultation</a>
            <a href="/videos" class="btn btn-outline-white">View Our Films</a>
          </div>
        </div>
      </div>
    <% } else { %>
      <% heroSlides.forEach((slide, index) => { %>
        <div class="hero-slide <%= index === 0 ? 'active' : '' %>" style="background-image: url('<%= slide.image_path %>');">
          <div class="hero-overlay"></div>
          <div class="hero-content container">
            <span class="eyebrow" style="color: var(--gold); margin-bottom: 1.5rem;"><%= slide.subtitle || 'Luxury Showcase' %></span>
            <h1 class="display-headline">
              <% const words = (slide.title || 'Crafting Timeless Moments').split(' '); %>
              <% words.forEach(word => { %>
                <span class="word"><%= word %></span>
              <% }) %>
            </h1>
            <div class="hero-btns">
              <a href="/contact" class="btn btn-gold">Book a Consultation</a>
              <a href="/videos" class="btn btn-outline-white">View Our Films</a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Slide Navigation Controls (Only if slides > 1) -->
  <% if (heroSlides.length > 1) { %>
    <div class="hero-controls">
      <button class="hero-ctrl-btn prev" aria-label="Previous Slide">&lsaquo;</button>
      <button class="hero-ctrl-btn next" aria-label="Next Slide">&rsaquo;</button>
    </div>
    <div class="hero-dots">
      <% heroSlides.forEach((_, index) => { %>
        <button class="hero-dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>"></button>
      <% }) %>
    </div>
  <% } %>

  <div class="scroll-indicator">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</header>

<!-- Section 2: Stats -->
<section class="stats reveal">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <h3 class="stat-number" data-target="150" data-suffix="+">0+</h3>
        <p>Films Completed</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="450" data-suffix="+">0+</h3>
        <p>Photoshoots</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="12" data-suffix="+">0+</h3>
        <p>Industry Awards</p>
      </div>
      <div class="stat-item">
        <h3 class="stat-number" data-target="99" data-suffix="%">0%</h3>
        <p>Happy Clients</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: About Us -->
<section id="about" class="about reveal">
  <div class="container">
    <div class="about-grid">
      <div class="about-img">
        <img src="<%= settings.about_image %>" alt="About <%= settings.store_name %> Team" loading="lazy">
      </div>
      <div class="about-content">
        <div class="gold-rule"></div>
        <span class="eyebrow"><%= settings.about_eyebrow %></span>
        <h2 class="section-headline"><%= settings.about_title %></h2>
        <p><%= settings.about_text1 %></p>
        <% if (settings.about_text2) { %>
          <p><%= settings.about_text2 %></p>
        <% } %>
        <a href="/contact" class="gold-link">Let's Create Together</a>
      </div>
    </div>
  </div>
</section>

